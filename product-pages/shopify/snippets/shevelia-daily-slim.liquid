{% liquid
 assign prefix = 'ds'
 assign selected = product.selected_or_first_available_variant
 if product.selected_variant == blank
 for candidate in product.variants
 if candidate.title == '3 Bottles' and candidate.available
 assign selected = candidate
 endif
 endfor
 endif
 assign selected_bottles = selected.title | split: ' ' | first | plus: 0
 if selected_bottles < 1
 assign selected_bottles = 1
 endif
 assign initial_bundle_file = prefix | append: '-' | append: selected_bottles | append: '.webp'
 assign initial_bundle_image = initial_bundle_file | asset_url
 if selected.featured_image
 assign initial_bundle_image = selected.featured_image | image_url: width: 1400
 endif
%}
