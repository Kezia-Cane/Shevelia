{% assign video_count = 0 %}{% for block in section.blocks %}{% if block.type == 'testimonial' and block.settings.video != blank %}{% assign video_count = video_count | plus: 1 %}{% endif %}{% endfor %}
{% if video_count > 0 %}<div class="shv-section-intro" style="margin-top:40px"><div><span class="shv-eyebrow">In their own words</span><h3>Watch their experiences.</h3></div></div><div class="shv-portrait-grid">
{% for block in section.blocks %}{% if block.type == 'testimonial' and block.settings.video != blank %}<figure class="shv-film" {{ block.shopify_attributes }}><div class="shv-film-frame">{{ block.settings.video | video_tag: controls: true, preload: 'none', playsinline: true, image_size: '700x' }}</div><figcaption><span>{{ block.settings.name | escape }}</span><small>{{ block.settings.disclosure | escape }}</small></figcaption>{% if block.settings.transcript != blank %}<details><summary>Read transcript</summary><p>{{ block.settings.transcript | escape | newline_to_br }}</p></details>{% endif %}</figure>{% endif %}{% endfor %}</div>{% endif %}