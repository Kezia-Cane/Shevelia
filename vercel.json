{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/about-us",
      "destination": "/about-us/",
      "permanent": true
    },
    {
      "source": "/products",
      "destination": "/products/",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/website-redesign-pages/homepage",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/website-redesign-pages/about-us",
      "destination": "/about-us",
      "permanent": true
    },
    {
      "source": "/website-redesign-pages/products",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/website-redesign-pages/contact",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/website-redesign-pages/shipping-policy",
      "destination": "/shipping-policy",
      "permanent": true
    },
    {
      "source": "/website-redesign-pages/refund-policy",
      "destination": "/refund-policy",
      "permanent": true
    },
    {
      "source": "/website-redesign-pages/privacy-policy",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/website-redesign-pages/terms-of-service",
      "destination": "/terms-of-service",
      "permanent": true
    },
    {
      "source": "/website-redesign-pages/intellectual-property-rights",
      "destination": "/intellectual-property-rights",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/about-us/",
      "destination": "/website-redesign-pages/about-us"
    },
    {
      "source": "/about-us/:path*",
      "destination": "/website-redesign-pages/about-us/:path*"
    },
    {
      "source": "/products/",
      "destination": "/website-redesign-pages/products"
    },
    {
      "source": "/products/:path*",
      "destination": "/website-redesign-pages/products/:path*"
    },
    {
      "source": "/contact/",
      "destination": "/website-redesign-pages/contact"
    },
    {
      "source": "/contact/:path*",
      "destination": "/website-redesign-pages/contact/:path*"
    },
    {
      "source": "/homepage/",
      "destination": "/website-redesign-pages/homepage"
    },
    {
      "source": "/shared/:path*",
      "destination": "/website-redesign-pages/shared/:path*"
    },
    {
      "source": "/homepage/:path*",
      "destination": "/website-redesign-pages/homepage/:path*"
    },
    {
      "source": "/shipping-policy/",
      "destination": "/website-redesign-pages/shipping-policy"
    },
    {
      "source": "/shipping-policy/:path*",
      "destination": "/website-redesign-pages/shipping-policy/:path*"
    },
    {
      "source": "/refund-policy/",
      "destination": "/website-redesign-pages/refund-policy"
    },
    {
      "source": "/refund-policy/:path*",
      "destination": "/website-redesign-pages/refund-policy/:path*"
    },
    {
      "source": "/privacy-policy/",
      "destination": "/website-redesign-pages/privacy-policy"
    },
    {
      "source": "/privacy-policy/:path*",
      "destination": "/website-redesign-pages/privacy-policy/:path*"
    },
    {
      "source": "/terms-of-service/",
      "destination": "/website-redesign-pages/terms-of-service"
    },
    {
      "source": "/terms-of-service/:path*",
      "destination": "/website-redesign-pages/terms-of-service/:path*"
    },
    {
      "source": "/intellectual-property-rights/",
      "destination": "/website-redesign-pages/intellectual-property-rights"
    },
    {
      "source": "/intellectual-property-rights/:path*",
      "destination": "/website-redesign-pages/intellectual-property-rights/:path*"
    }
  ]
}
